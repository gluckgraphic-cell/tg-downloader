# ---- Docker ----
# The folder on the server you choose destinations from (e.g. /volume1/Media or /mnt/media)
DOWNLOADS_PATH=./downloads
# Run as this user/group so downloads belong to you (run `id` on the server to see yours)
PUID=1000
PGID=1000
# Web port
PORT=8765

# ---- App ----
# Optional: can be left empty and entered on the setup screen instead (https://my.telegram.org)
API_ID=
API_HASH=
# Optional password for the site (any username). Empty = no password, keep it on your home network only
APP_PASSWORD=
# How many files download at the same time
MAX_PARALLEL=2
